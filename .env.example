# Pinnacle Care Homes - Example Environment Configuration
# Copy this file to .env and configure your values.

# Core Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Authentication & Brute-Force Protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900
IP_MAX_FAILED_ATTEMPTS=15

# Session Hardening
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# Media & File Upload Security
MAX_UPLOAD_SIZE_MB=3

# Database Settings (Docker PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pinnacle_db
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis Cache Settings (Optional Devilbox Redis)
# REDIS_URL=redis://127.0.0.1:6379/1

